<mxfile host="app.diagrams.net"><diagram name="NotificationUML" id="notif"><mxGraphModel dx="1460" dy="806" grid="1" gridSize="10" page="1" pageWidth="1460" pageHeight="806" background="#121212"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Notification" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=50;horizontalStack=0;resizeParent=1;collapsible=0;fillColor=none;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="620" height="514" as="geometry"/></mxCell><mxCell id="n4" value="+ UID: String&lt;br&gt;- notification_type: NotificationType&lt;br&gt;- sender: CampsiteOwner&lt;br&gt;- campsite: Campsite&lt;br&gt;- title: String&lt;br&gt;- message: String&lt;br&gt;- _recipients: List&amp;lt;Entrant&amp;gt;&lt;br&gt;- date_sent: String&lt;br&gt;+ recipients: List&amp;lt;Entrant&amp;gt; (read-only)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;fillColor=none;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="n3"><mxGeometry y="50" width="620" height="258" as="geometry"/></mxCell><mxCell id="n5" value="+ getNotificationType(): NotificationType&lt;br&gt;+ getSender(): CampsiteOwner&lt;br&gt;+ getCampsite(): Campsite&lt;br&gt;+ getTitle(): String&lt;br&gt;+ getMessage(): String&lt;br&gt;+ getDateSent(): String&lt;br&gt;+ send(opted_out: List&amp;lt;Entrant&amp;gt;): List&amp;lt;Entrant&amp;gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;fillColor=none;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="n3"><mxGeometry y="308" width="620" height="206" as="geometry"/></mxCell><mxCell id="n6" value="&amp;laquo;enumeration&amp;raquo;&lt;br&gt;&lt;b&gt;NotificationType&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=70;horizontalStack=0;resizeParent=1;collapsibl