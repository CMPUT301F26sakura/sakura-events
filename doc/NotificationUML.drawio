olor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="680" y="458" width="200" height="30" as="geometry"/></mxCell><mxCell id="n22" value="1" style="text;html=1;align=right;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1000" y="464" width="50" height="30" as="geometry"/></mxCell><mxCell id="n23" value="" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="10" height="10" as="geometry"/></mxCell><mxCell id="n24" value="A Notification is created only when a Campsite Owner hits send, and every property is a val, so it can never be changed afterwards. This lets it work as a permanent log that Campsite Owners and Admins can review. The date is generated by the system. send() does not change the recipients; it returns the entrants who have not opted out, so they are the ones who get it." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1380" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>