y="356" width="60" height="30" as="geometry"/></mxCell><mxCell id="n20" style="endArrow=none;html=1;strokeColor=#FFFFFF;strokeWidth=2;endArrow=open;endSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="738" as="sourcePoint"/><mxPoint x="1060" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="notification_type" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="680" y="698" width="200" height="30" as="geometry"/></mxCell><mxCell id="n22" value="1" style="text;html=1;align=right;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1000" y="704" width="50" height="30" as="geometry"/></mxCell><mxCell id="n23" value="Entrants, the sender and the campsite are stored by their UID Strings instead of object references so a Notification can be saved straight to Firestore. The lines above still show who a Notification is connected to. Sender is 0..1 because automatic notifications (lottery results, confirmations) are sent by the &quot;system&quot; instead of a Campsite Owner." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="720" height="150" as="geometry"/></mxCell><mxCell id="n24" value="Every edit method returns false once is_sent is true, so a sent Notification works as a permanent log that Campsite Owners and Admins can review. send() removes entrants who opted out before sending." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#FFFFFF;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="620" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>